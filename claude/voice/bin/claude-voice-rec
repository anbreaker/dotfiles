#!/usr/bin/env python3
"""Record one utterance from the default microphone, with a pre-roll buffer.

The last PRE_ROLL_FRAMES of audio are always kept, so when speech is detected the
beginning of the first word is not lost (sox's silence effect drops it).

Usage: claude-voice-rec OUT.wav START_PCT END_PCT SILENCE_SECONDS [MAX_SECONDS]
Exit code 0 when an utterance was written, 3 when it was discarded because `say` was
speaking, 1 otherwise.
"""
import array
import collections
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import wave

RATE = 16000
FRAME_SAMPLES = 320          # 20 ms
FRAME_BYTES = FRAME_SAMPLES * 2
PRE_ROLL_FRAMES = 30         # 0.6 s of audio kept before the trigger
START_FRAMES = 4             # 80 ms above the start threshold to begin recording
SAY_CHECK_EVERY = 5          # look for a running `say` every 100 ms
SAY_COOLDOWN = 1.0           # seconds to keep ignoring audio after `say` stops (echo tail)

# Overridable for tests: a command that writes raw s16le 16 kHz mono audio to stdout.
REC_CMD = os.environ.get(
    "CLAUDE_VOICE_REC_CMD",
    "rec -q -c 1 -b 16 -e signed-integer -L -t raw - rate 16000",
)


SPEAKING_PIDFILE = os.path.expanduser("~/.cache/claude-voice/speaking.pid")
HEADSET_RE = re.compile(
    os.environ.get("CLAUDE_VOICE_HEADSET_RE", "corsair|hs80|headset|headphone|auricular|airpods"),
    re.IGNORECASE,
)


def headset_output():
    """True when the current output device looks like a headset (no speaker-to-mic leak)."""
    tool = shutil.which("SwitchAudioSource") or next(
        (p for p in ("/opt/homebrew/bin/SwitchAudioSource", "/usr/local/bin/SwitchAudioSource") if os.path.exists(p)),
        "SwitchAudioSource",
    )
    try:
        name = subprocess.run(
            [tool, "-c", "-t", "output"], capture_output=True, text=True, timeout=2
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return bool(HEADSET_RE.search(name))


def say_running():
    """True while claude-speak (pidfile) or the macOS `say` fallback is speaking."""
    try:
        with open(SPEAKING_PIDFILE) as handle:
            os.kill(int(handle.read().strip()), 0)
        return True
    except (OSError, ValueError):
        pass
    return subprocess.run(["pgrep", "-x", "say"], stdout=subprocess.DEVNULL).returncode == 0


def rms(raw):
    samples = array.array("h")
    samples.frombytes(raw)
    if sys.byteorder == "big":
        samples.byteswap()
    return math.sqrt(sum(s * s for s in samples) / len(samples)) / 32768.0


def main():
    out = sys.argv[1]
    start_level = float(sys.argv[2]) / 100
    end_level = float(sys.argv[3]) / 100
    end_frames = int(float(sys.argv[4]) * RATE / FRAME_SAMPLES)
    max_frames = int((float(sys.argv[5]) if len(sys.argv) > 5 else 20) * RATE / FRAME_SAMPLES)

    proc = subprocess.Popen(shlex.split(REC_CMD), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    pre_roll = collections.deque(maxlen=PRE_ROLL_FRAMES)
    frames = []
    recording = False
    above = 0
    quiet = 0
    muted_until = 0.0
    frame_count = 0
    speaking = False
    barge_in = False   # headset output: our own voice cannot leak into the mic, so you may interrupt
    try:
        while True:
            raw = proc.stdout.read(FRAME_BYTES)
            if len(raw) < FRAME_BYTES:
                break
            # Never keep audio captured while we speak through speakers (or just after): it is our own voice.
            # With a headset there is no leak, so speech is kept and interrupts the reading.
            frame_count += 1
            if frame_count % SAY_CHECK_EVERY == 0:
                was_speaking = speaking
                speaking = say_running()
                if speaking and not was_speaking:
                    barge_in = headset_output()
                if speaking and not barge_in:
                    muted_until = time.time() + SAY_COOLDOWN
            if time.time() < muted_until:
                if recording:
                    return 3
                pre_roll.clear()
                above = 0
                continue
            level = rms(raw)
            if not recording:
                pre_roll.append(raw)
                above = above + 1 if level >= start_level else 0
                if above >= START_FRAMES:
                    recording = True
                    frames = list(pre_roll)
                    if speaking and barge_in:
                        subprocess.Popen(
                            [os.path.expanduser("~/.local/bin/claude-speak"), "stop"],
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL,
                        )
            else:
                frames.append(raw)
                quiet = quiet + 1 if level < end_level else 0
                if quiet >= end_frames or len(frames) >= max_frames:
                    break
    finally:
        proc.terminate()
        proc.wait()

    if not recording:
        return 1
    with wave.open(out, "wb") as wav:
        wav.setnchannels(1)
        wav.setsampwidth(2)
        wav.setframerate(RATE)
        wav.writeframes(b"".join(frames))
    return 0


if __name__ == "__main__":
    sys.exit(main())
